{
  "name": "apistock",
  "private": true,
  "description": "Suivi de portefeuille d'ETF — site statique, sans dépendance",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "sw-version": "node scripts/sw-version.mjs",
    "check": "node scripts/sw-version.mjs --check && node --test tests/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.mjs",
    "record-fixtures": "node scripts/record-fixtures.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
