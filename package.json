{
  "name": "apistock",
  "private": true,
  "description": "Suivi de portefeuille d'ETF — site statique, sans dépendance à l'exécution (outils de développement seulement)",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "sw-version": "node scripts/sw-version.mjs",
    "check": "eslint . && node scripts/sw-version.mjs --check && node --test tests/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.mjs",
    "record-fixtures": "node scripts/record-fixtures.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "chart.js": "4.4.1",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "playwright": "1.63.0"
  }
}
